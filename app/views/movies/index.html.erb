<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<div id="movies">
<table>
  <thead>
    <tr>
      <th class="<%= "sorted-#{@direction}" if @column == "title" %>"><%= link_to "Title", movies_path(sort: "title", direction: ((@column == "title" && @direction == "asc") ? "desc" : "asc")) %><%= (@direction == "asc" ? "▲" : "▼") if @column == "title" %></th>
      <th class="<%= "sorted-#{@direction}" if @column == "rating" %>"><%= link_to "Rating", movies_path(sort: "rating", direction: ((@column == "rating" && @direction == "asc") ? "desc" : "asc")) %><%= (@direction == "asc" ? "▲" : "▼") if @column == "rating" %></th>
      <th class="<%= "sorted-#{@direction}" if @column == "release_date" %>"><%= link_to "Release Date", movies_path(sort: "release_date", direction: ((@column == "release_date" && @direction == "asc") ? "desc" : "asc")) %><%= (@direction == "asc" ? "▲" : "▼") if @column == "release_date" %></th>
      <th>Links</th>
    </tr>
  </thead>
  <tbody>
  <% @movies.each do |movie| %>
  <tr>
    <td><%= movie.title %></td>
    <td><%= movie.rating %></td>
    <td><%= movie.release_date&.strftime("%b %d, %Y") %></td>
    <td>
      <%= link_to "Details", movie %>
    </td>
  </tr>
  <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="4">
      <%= link_to "New movie", new_movie_path %>
      </td>
    </tr>
  </tfoot>
</table>
</div>

